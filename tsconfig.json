{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "lib/*": ["./src/lib/*"],
      "style/*": ["./src/styles/*"]
    }
  }
}
